model Post {
  id          Int       @id @default(autoincrement())
  title       String
  topic       String
  description String
  views       Int
  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int
  createdAt   DateTime  @default(now())
  tagPosts    TagPost[]
  links       Link[]
  images      Image[]
}
