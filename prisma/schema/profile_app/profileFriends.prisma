model ProfileFriends {
  id Int @id @default(autoincrement())

  fromProfile   Profile @relation("from_profile_link", fields: [fromProfileId], references: [id])
  fromProfileId Int     @map("from_profile_id")

  toProfile   Profile @relation("to_profile_link", fields: [toProfileId], references: [id])
  toProfileId Int     @map("to_profile_id")

  @@map("profile_app_profile_friends")
}
