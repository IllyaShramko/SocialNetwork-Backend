model FriendsRequest {
  id Int @id @default(autoincrement())

  fromProfile   Profile @relation("from_profile", fields: [fromProfileId], references: [id])
  fromProfileId Int     @map("from_profile_id")

  toProfile   Profile @relation("to_profile", fields: [toProfileId], references: [id])
  toProfileId Int     @map("to_profile_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("profile_app_friendrequest")
}
