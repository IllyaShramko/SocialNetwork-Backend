model FriendShip {
  id         Int      @id @default(autoincrement())
  status     String   @db.VarChar(10)
  created_at DateTime @db.Timestamptz(6)
  fromUserId Int      @map("from_user_id")
  toUserId   Int      @map("to_user_id")
  fromUser   User     @relation("from_user", fields: [fromUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_app_friendship_from_user_id_e1d46b12_fk_user_app_user_id")
  toUser     User     @relation("to_user", fields: [toUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_app_friendship_to_user_id_f5d68c80_fk_user_app_user_id")

  @@unique([fromUserId, toUserId], map: "user_app_friendship_from_user_id_to_user_id_1917f941_uniq")
  @@index([fromUserId], map: "user_app_friendship_from_user_id_e1d46b12")
  @@index([toUserId], map: "user_app_friendship_to_user_id_f5d68c80")
  @@map("user_app_friendship")
}
