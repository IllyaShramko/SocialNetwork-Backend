model Image {
  id        Int      @id @default(autoincrement())
  filename  String
  isVisible Boolean
  album     Album?   @relation(fields: [albumId], references: [id])
  albumId   Int?
  post      Post?    @relation(fields: [postId], references: [id])
  postId    Int?
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  avatars   Avatar[]
}
